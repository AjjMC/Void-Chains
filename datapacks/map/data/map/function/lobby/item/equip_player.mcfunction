item replace entity @s hotbar.0 with minecraft:written_book[minecraft:custom_data={map:{item:1b,game_info:1b}},minecraft:tooltip_display={hidden_components:["minecraft:written_book_content"]},minecraft:enchantment_glint_override=false,minecraft:written_book_content={pages:[ \
    [{text:""},{text:"VOID CHAINS\n\n",bold:true},{text:"Void Chains is a PvP minigame that brings together aspects from several game modes, including KOTH and Spleef. The two competing teams battle in an arena consisting of Anchors and Bridges, suspended over the void.",color:"dark_gray"}], \
    [{text:""},{text:"A TEAM'S ANCHORS\n\n",bold:true},{text:"- Act as respawn points for the team.\n\n- Can be generated by the team on its Bridges.\n\n- Can be claimed by the other team.",color:"dark_gray"}], \
    [{text:""},{text:"A TEAM'S BRIDGES\n\n",bold:true},{text:"- Can be formed from within the team's territory.\n\n- Collapse if they are not connected to any of the team's Anchors.\n\n- Override the other team's Bridges.",color:"dark_gray"}], \
    [{text:""},{text:"A TEAM WITHOUT ANCHORS\n\n",bold:true},{text:"- Cannot respawn until an Anchor becomes available.\n\n- Loses if none of its players are able to play.",color:"dark_gray"}], \
    ],title:"Game Info",author:Ajj},minecraft:lore=[{text:"Void Chains [1.17.1]",color:"gray",italic:0b}]]

